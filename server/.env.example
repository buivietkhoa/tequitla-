NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/fashion-shop

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Optional: Cloudinary for product image hosting (recommended for CDN + fast image delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP for transactional email (forgot password, ...). Works with any SMTP
# provider — Resend, SendGrid, Brevo, Gmail App Password, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SHMILY <no-reply@shmily.vn>

# VNPay sandbox (https://sandbox.vnpayment.vn/apis/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# The browser is redirected here by VNPay after payment. It must point at the
# SERVER (not the client) so the signature can be verified before the user is
# forwarded on to their order page. Also register the /ipn URL below as the
# "IPN URL" in the VNPay sandbox merchant portal (server-to-server callback).
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:5000/api/payments/vnpay/ipn

# Momo sandbox (https://developers.momo.vn/)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Same idea as VNPay: redirectUrl must point at the server so it can verify
# before forwarding the user to their order page. ipnUrl is the authoritative
# server-to-server confirmation Momo calls regardless of what the user's browser does.
MOMO_REDIRECT_URL=http://localhost:5000/api/payments/momo/return
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn
